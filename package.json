{
    "name": "colony-os",
    "version": "0.1.0",
    "description": "A TypeScript Screeps implementation.",
    "private": true,
    "packageManager": "npm@11.19.1",
    "engines": {
        "node": ">=24 <25"
    },
    "main": "dist/main.js",
    "scripts": {
        "build": "node scripts/build.mjs",
        "check": "npm run verify && npm run build",
        "deploy:main": "npm run build && node scripts/deploy.mjs main",
        "deploy:sim": "npm run build && node scripts/deploy.mjs sim",
        "format": "prettier --write . --ignore-unknown",
        "format:check": "prettier --check . --ignore-unknown",
        "lint": "eslint .",
        "prepare": "husky",
        "predeploy:main": "npm run verify",
        "predeploy:sim": "npm run verify",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "verify": "npm run format:check && npm run lint && npm test && npm run typecheck",
        "watch": "node scripts/build.mjs --watch",
        "watch:sim": "node scripts/build.mjs --watch --deploy sim"
    },
    "prettier": {
        "semi": true,
        "tabWidth": 4,
        "useTabs": false,
        "printWidth": 120,
        "singleQuote": false,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "endOfLine": "auto"
    },
    "keywords": [
        "screeps",
        "typescript"
    ],
    "license": "MIT",
    "dependencies": {
        "source-map": "~0.6.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.4",
        "@types/screeps": "^3.2.3",
        "esbuild": "^0.28.2",
        "eslint": "^10.10.0",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.9.6",
        "screeps-api": "^2.1.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.0"
    },
    "lint-staged": {
        "*": "prettier --write --ignore-unknown"
    },
    "overrides": {}
}
